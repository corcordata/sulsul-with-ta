# 这个服务对外的地址（要 https）。截图链接、info 印出来的配置都用它。必填
SULSUL_PUBLIC_URL=https://sims.example.com

# 玩家在游戏里说话 / 游戏里出了事 / 玩家发来截图时，往这个地址 POST。只用 MCP 连接器就留空
SULSUL_WEBHOOK_URL=
# 推送时带的钥匙（Authorization: Bearer …），可不填
SULSUL_WEBHOOK_TOKEN=

# 你把 TA 的每句回话都交给 POST /sims/reply 了吗？交了填 1
SULSUL_REPLY_MIRROR=

# 给 TA 看的字里怎么称呼玩家：她 / 他 / TA
SULSUL_PLAYER_PRONOUN=她

SULSUL_PORT=8787
SULSUL_DATA=data

# 两把钥匙。留空就自动生成、存在 data/tokens.json，用 python -m sulsul_server info 看
SULSUL_MOD_TOKEN=
SULSUL_TA_TOKEN=
