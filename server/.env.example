# 这个服务对外的地址（要 https）。截图链接、info 印出来的配置都用它。必填
SIMSLINK_PUBLIC_URL=https://sims.example.com

# 玩家在游戏里说话 / 游戏里出了事 / 玩家发来截图时，往这个地址 POST。只用 MCP 连接器就留空
SIMSLINK_WEBHOOK_URL=
# 推送时带的钥匙（Authorization: Bearer …），可不填
SIMSLINK_WEBHOOK_TOKEN=

# 你把 TA 的每句回话都交给 POST /sims/reply 了吗？交了填 1
SIMSLINK_REPLY_MIRROR=

# 给 TA 看的字里怎么称呼玩家：她 / 他 / TA
SIMSLINK_PLAYER_PRONOUN=她

SIMSLINK_PORT=8787
SIMSLINK_DATA=data

# 两把钥匙。留空就自动生成、存在 data/tokens.json，用 python -m simslink_server info 看
SIMSLINK_MOD_TOKEN=
SIMSLINK_TA_TOKEN=
